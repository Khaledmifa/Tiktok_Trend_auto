# ==============================================================================
# Environment Variables Template (.env) — Viral Studio Pro ($0 Local Stack)
# Copy this file to .env and fill in ONLY Telegram Bot API credentials.
# ==============================================================================

# 1. Telegram MTProto Bot Credentials (100% Free — supports up to 2 GB uncompressed uploads)
# Obtain TELEGRAM_API_ID and TELEGRAM_API_HASH for free at https://my.telegram.org
# Obtain TELEGRAM_BOT_TOKEN from @BotFather
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Optional Local Ollama ($0 local LLM on RTX 5060 — uncomment only if Ollama is running)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
